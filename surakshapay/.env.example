PORT=3001
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://localhost:27017/surakshapay
# Atlas:   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/surakshapay
MONGODB_URI=mongodb://localhost:27017/surakshapay

# REQUIRED — generate your own, never reuse this example value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_value

CLAIMS_EMAIL=claims@surakshapay.ai

# Set to "false" to see real (non-padded) numbers on the admin dashboard
SHOW_DEMO_NUMBERS=true
